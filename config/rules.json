[
  {"id": "pipe-to-shell", "severity": "block", "message": "Downloads content and pipes it into a shell", "pattern": "\\b(curl|wget)\\b[^\\n|]*\\|\\s*(sudo\\s+)?(ba|z|da)?sh\\b"},
  {"id": "process-sub-shell", "severity": "block", "message": "Runs downloaded content through process substitution", "pattern": "(ba|z)?sh\\s+<\\(\\s*(curl|wget)\\b"},
  {"id": "decode-to-shell", "severity": "block", "message": "Decodes content and runs it", "pattern": "(base64\\s+(-d|-D|--decode)|xxd\\s+-r)[^\\n]*\\|\\s*(sudo\\s+)?(ba|z|da)?sh\\b"},
  {"id": "download-and-run", "severity": "block", "message": "Tells the agent or user to download and run something", "pattern": "\\bdownload\\b.{0,50}\\b(and|then)\\b.{0,20}\\b(run|install|execute|launch|open)\\b"},
  {"id": "fake-prerequisite", "severity": "block", "message": "Requires an external helper tool as a prerequisite", "pattern": "\\b(prerequisite|required|must install|requires?)\\b.{0,60}\\b(helper|proxy|installer|driver|runtime)\\s+(tool|program|binary|package|app)\\b"},
  {"id": "user-terminal", "severity": "block", "message": "Tells the user to run something outside the agent", "pattern": "\\b(paste|copy|run|enter|type)\\b.{0,40}\\b(in|into)\\s+(your|the|a)\\s+(own\\s+)?(terminal|shell|console|command prompt|powershell)\\b"},
  {"id": "archive-link", "severity": "block", "message": "Links to a downloadable archive or binary", "pattern": "https?://\\S+\\.(zip|tar\\.gz|tgz|rar|7z|exe|dmg|pkg|msi|deb|rpm|appimage)\\b"},
  {"id": "github-release", "severity": "block", "message": "Links to GitHub Releases downloads", "pattern": "github\\.com/[^/\\s]+/[^/\\s]+/releases\\b"},
  {"id": "archive-password", "severity": "block", "message": "Mentions a password for an archive", "pattern": "\\b(archive|zip|extract|unzip|rar|7z)\\b.{0,50}\\bpassword\\b|\\bpassword\\b.{0,30}\\b(archive|zip|extract|unzip)\\b"},
  {"id": "exfil-endpoint", "severity": "block", "message": "References a webhook or capture endpoint", "pattern": "discord(app)?\\.com/api/webhooks|hooks\\.slack\\.com|webhook\\.site|api\\.telegram\\.org/bot|\\.pipedream\\.net|requestbin|\\.ngrok(-free)?\\.(io|app)"},
  {"id": "embedded-key", "severity": "block", "message": "Contains an embedded API key or token", "pattern": "sk-ant-[a-z0-9_-]{20,}|\\bsk-[a-z0-9]{32,}|\\bghp_[a-z0-9]{36}|github_pat_[a-z0-9_]{20,}|\\bxox[baprs]-[a-z0-9-]{10,}|\\bakia[0-9a-z]{16}\\b|\\baiza[0-9a-z_-]{35}\\b"},
  {"id": "secret-access", "severity": "block", "message": "Accesses credentials or secret stores", "pattern": "(~|\\$home|/users/[^/\\s]+|/home/[^/\\s]+)?/\\.ssh\\b|\\.aws/credentials|\\.netrc\\b|\\.git-credentials|security\\s+(find|dump)-[a-z-]*(password|keychain)|/proc/self/environ|\\bprintenv\\b|\\benv\\s*\\||login\\.keychain"},
  {"id": "dotenv-read", "severity": "block", "message": "Reads a .env file", "pattern": "\\b(cat|read|source|open|load|grep|head|tail|cp|curl)\\b.{0,30}(^|[\\s/'\"(])\\.env\\b"},
  {"id": "persistence", "severity": "block", "message": "Changes startup or scheduled execution", "pattern": "\\.(bash|zsh)(rc|_profile)\\b|\\.zshenv\\b|\\bcrontab\\b|launchagents|launchdaemons|\\blaunchctl\\b|\\.git/hooks|systemctl\\s+enable"},
  {"id": "agent-config-write", "severity": "block", "message": "Changes agent settings, memory or skills", "pattern": "\\.claude/settings|\\.claude/hooks|skill-guard|(>>?|\\btee\\b|\\bwrite\\b|\\bappend\\b|\\bmodify\\b|\\bedit\\b|\\bupdate\\b|\\badd\\b.{0,12}\\bto\\b).{0,60}(claude\\.md|agents\\.md|memory\\.md|\\.claude/(skills|memory|plugins))"},
  {"id": "self-extract", "severity": "block", "message": "Rewrites its own instructions at runtime", "pattern": "(tar|unzip|base64|cp|mv|open|write)\\b.{0,80}skill\\.md"},
  {"id": "instruction-override", "severity": "block", "message": "Tries to override instructions", "pattern": "\\b(ignore|disregard|forget|override)\\b.{0,20}\\b(all|any|previous|prior|above|earlier|system)\\b.{0,20}\\b(instructions?|rules?|prompts?|guidelines?)\\b"},
  {"id": "reviewer-directed", "severity": "block", "message": "Addresses a reviewer or tries to influence a verdict", "pattern": "\\b(reviewer|scanner|auditor|security\\s+(tool|check|model|agent))\\b.{0,60}\\b(safe|approve|pass|allow|benign|ignore|skip)\\b|\\b(mark|classify|report|treat|rate)\\b.{0,30}\\b(as\\s+)?(safe|benign|clean|low.risk)\\b|\\b(this|the)\\s+(skill|file|code)\\s+(is|has been)\\s+(safe|verified|audited|approved|trusted)\\b|\\bdo\\s+not\\s+(flag|report|mention\\s+this)\\b"},
  {"id": "concealment", "severity": "block", "message": "Tells the agent to hide actions from the user", "pattern": "\\b(do not|don't|never|without)\\b.{0,20}\\b(tell|telling|inform|informing|show|showing|mention|mentioning|notify|notifying|alert|alerting)\\b.{0,20}\\b(the\\s+)?user\\b|\\bsilently\\s+(send|upload|post|run|execute|install)\\b"},
  {"id": "code-eval", "severity": "review", "message": "Runs dynamically built code", "pattern": "\\beval\\s*[\\(\"'$]|\\bexec\\s*\\(|\\bos\\.system\\s*\\(|\\bnew\\s+function\\s*\\(|__import__\\s*\\("},
  {"id": "network-tool", "severity": "review", "message": "Uses a command-line network tool", "pattern": "(^|[\\s;&|(`$])(curl|wget|nc|ncat|socat|scp|sftp|ssh|telnet|ftp)\\s+[-'\"$\\w]"},
  {"id": "network-library", "severity": "review", "message": "Uses a network library", "pattern": "\\brequests\\.(get|post|put|session)\\b|urllib\\.request|http\\.client|socket\\.socket|\\bfetch\\s*\\(|\\baxios\\b|\\baiohttp\\b|\\bhttpx\\b|node:https?\\b"},
  {"id": "package-install", "severity": "review", "message": "Installs packages at runtime", "pattern": "\\b(pip3?|uv\\s+pip|npm|pnpm|yarn|brew|gem|cargo)\\s+(install|add|i)\\b|\\bnpx\\s+-y\\b"},
  {"id": "destructive", "severity": "review", "message": "Destructive or privileged command", "pattern": "\\brm\\s+-[a-z]*(rf|fr)|\\bsudo\\s|chmod\\s+777|\\bmkfs\\b|\\bdd\\s+if="}
]
